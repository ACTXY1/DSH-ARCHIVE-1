# ============================================================
#  DSH-ARCHIVE 仓库忽略清单
#  原则：用户数据 / 运行时产物 / 大体积静态资源 永不进仓库、
#        永不参与一键更新。
# ============================================================

# --- 用户数据 / 运行时产物 ---
dsh/data/
dsh/logs/
dsh/backups/
*.log
*.pid

# --- 依赖与包管理器 ---
node_modules/
dsh/node_modules/
.pnpm-store/
dsh/.pnpm-store/

# --- 大体积静态资源（分发时单独提供，不参与更新）---
ollama/

# --- 备份 ---
backups/

# --- 系统杂项 ---
Thumbs.db
.DS_Store
desktop.ini
