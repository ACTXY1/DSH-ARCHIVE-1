# ============================================================
#  DSH-ARCHIVE 仓库忽略清单
#  原则：用户数据 / 运行时产物 / 大体积静态资源 永不进仓库、
#        永不参与一键更新。
# ============================================================

# --- 用户数据 / 运行时产物 ---
dsh/data/
dsh/logs/
dsh/backups/
#  独立化：项目自带 DSH 家目录（profiles/junction/agent-presets/dsh-tools 回退副本）
# 属运行时产物，绝不进仓库、不进分发包、不参与一键更新。
# 位置：项目根 .dsh-home（与 dsh 平级）——刻意不放在 dsh 内部，避免"home 在 dsh 里、
# 里面又有指向 dsh 的链接"形成祖先环（整目录复制会递归/失败）。旧路径 dsh/home 一并忽略。
.dsh-home/
dsh/home/
*.log
*.pid

# --- 依赖与包管理器 ---
node_modules/
dsh/node_modules/
.pnpm-store/
dsh/.pnpm-store/

# --- 大体积静态资源（分发时单独提供，不参与更新）---
ollama/

# --- 备份 ---
backups/

# --- 系统杂项 ---
Thumbs.db
.DS_Store
desktop.ini
